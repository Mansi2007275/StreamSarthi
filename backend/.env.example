# Copy to backend/.env for local dev. NEVER commit .env
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase -> Project Settings -> API Keys -> service_role / secret key (backend ONLY)
SUPABASE_SERVICE_KEY=
# Only if your project uses the legacy HS256 JWT secret. New projects: leave empty (JWKS is used).
SUPABASE_JWT_SECRET=

# AI: gemini (default) or openai_compatible (e.g. Groq)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
# AI_BASE_URL=https://api.groq.com/openai/v1

# Comma separated. Add your Vercel URL in production.
FRONTEND_ORIGIN=http://localhost:3000
